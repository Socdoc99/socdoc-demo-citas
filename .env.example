# Copia este archivo como .env y reemplaza cada valor. El archivo .env NO se sube al repo.
#
# Generar un secreto (Git Bash o WSL):  openssl rand -hex 32

TZ=America/Bogota

# Fija una versión de n8n después del primer arranque.
# Ver la versión:  docker compose exec n8n n8n --version
N8N_VERSION=latest

# Cifra las credenciales guardadas en n8n. Si se pierde, hay que recrear las credenciales.
N8N_ENCRYPTION_KEY=

# Administrador de la base de datos (solo para crearla y para tareas manuales).
POSTGRES_USER=postgres_admin
POSTGRES_PASSWORD=
POSTGRES_DB=citas

# Usuario n8n_app: el que usan los flujos. Solo puede leer y escribir lo necesario.
# Usa solo letras y números (hex) para evitar problemas con caracteres especiales.
APP_DB_PASSWORD=
